generator client {
  provider = "prisma-client-js"
//  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  id         Int      @id @default(autoincrement())
  name       String?  @db.VarChar
  email      String   @unique
  location   Json?
  status     String   @default("pending")
  created_at DateTime @default(now())
  
  sportClubs SportByClub[]    // relación inversa a SportClub
  schedules  ClubSchedule[] // relación inversa a ClubSchedule
}

model ClubSchedule {
  id         Int      @id @default(autoincrement())
  clubId     Int
  dayOfWeek  Int    // vamos a usar 0 = Domingo, 1 = Lunes, etc
  openTime   String
  closeTime  String

  club       Club     @relation(fields: [clubId], references: [id])
}

model Player {
  id           Int      @id @default(autoincrement())
  first_name   String?
  last_name    String?
  email        String   @unique
  picture      String?
  created_at   DateTime @default(now())
}

model OtpCode {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  code       String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Sport {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  clubs     SportByClub[]
}

model SportByClub {
  id        Int        @id @default(autoincrement())
  clubId    Int
  sportId   Int
  isActive  Boolean    @default(true)

  club      Club       @relation(fields: [clubId], references: [id])
  sport     Sport      @relation(fields: [sportId], references: [id])
  courts    Court[]

  @@unique([clubId, sportId]) 
}

model Court {
  id              Int       @id @default(autoincrement())
  idSportClub     Int
  courtNumber     Int
  pricePerHour    Float
  isAvailable     Boolean   @default(true)

  sportClub   SportByClub @relation(fields: [idSportClub], references: [id])
  // reservations Reservation[] <- descomentar cuando se agregue la tabla
}